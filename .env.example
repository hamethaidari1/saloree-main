# Supabase (publishable values only — never put a service-role key here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Main marketplace domain. Each store is served at <slug>.<VITE_ROOT_DOMAIN>,
# which needs a wildcard DNS record (*.saloree.com) and a wildcard TLS certificate.
# In development use http://localhost:8080/?store=<slug> instead.
VITE_ROOT_DOMAIN=saloree.com

# Card payments with Stripe Checkout (customers pay on Stripe's hosted page).
# "true" shows "Pay by card" at checkout; anything else (default) hides it and
# the shop stays pay-on-delivery only. Build-time flag: rebuild after changing.
# Turn it on only after the create-checkout-session and stripe-webhook Edge
# Functions are deployed and their Stripe keys are set as Supabase secrets.
# The app itself never needs a Stripe key: never put a Stripe secret key or webhook secret here.
VITE_STRIPE_ENABLED=false

# Store traffic (seller analytics). SERVER-ONLY secret: never prefix it with VITE_,
# it must never reach the browser. Any long random string (e.g. 64 hex characters).
# Set it in the hosting provider's environment variables (e.g. Vercel). Without it,
# no visits are recorded. Changing it makes everyone count as a new visitor that day.
TRACK_SALT=

# Google Search Console: the token from the HTML-tag method (only the content="..." value).
# Server-only; set it in the hosting provider's environment variables, then redeploy.
GOOGLE_SITE_VERIFICATION=
